{
  "name": "@zqg/cometflow",
  "version": "0.1.0",
  "description": "Full-time autonomous agent development platform",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cometflow": "dist/app/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "prepublishOnly": "npm run build && npm test",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx app/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package-e2e": "node scripts/release/package-e2e.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
