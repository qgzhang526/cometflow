{
  "name": "@zqg/cometflow",
  "version": "0.3.1",
  "description": "Spec-driven (SDD) autonomous agent development platform: agents implement, independent verifiers and gates decide, schedulers run unattended",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cometflow": "dist/app/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "web/dist"
  ],
  "prepublishOnly": "npm run build && npm test",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "dev": "tsx app/cli/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "vue-tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package-e2e": "node scripts/release/package-e2e.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.11"
  }
}
